# ============================================================
# Lead Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── n8n Configuration ────────────────────────────────────────
# Base URL of your n8n instance (no trailing slash)
N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# The full webhook URL generated by n8n (shown when you activate the workflow)
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/lead-form

# Optional: shared secret for webhook signature validation
N8N_WEBHOOK_SECRET=change-me-to-a-random-string

# ── Google Sheets ────────────────────────────────────────────
# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_ID=your-google-sheet-id-here

# Name of the sheet/tab within the spreadsheet
GOOGLE_SHEETS_TAB_NAME=Leads

# Path to the Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# ── Gmail ────────────────────────────────────────────────────
# Gmail address used to send confirmation emails
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_SENDER_NAME=DigiHust Lead System

# OAuth2 credentials (configured in n8n's Gmail credential)
GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# ── Discord ──────────────────────────────────────────────────
# Webhook URL for internal sales notifications
# Create at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── CRM (HubSpot) ───────────────────────────────────────────
# CRM provider: hubspot | mock
CRM_PROVIDER=hubspot

# HubSpot Private App access token
# Create at: Settings → Integrations → Private Apps → Create
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# HubSpot API base URL (do not change unless using EU data center)
HUBSPOT_BASE_URL=https://api.hubapi.com

# ── Application Mode ────────────────────────────────────────
# production = all integrations active (credentials required)
# test       = mock mode for services without credentials
APP_MODE=test
