    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Aggregate Results & Update Status \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst lead = $('Prepare Downstream').first().json;\n\n// \u2500\u2500 Check email result \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet emailStatus = 'pending';\nlet emailError = '';\ntry {\n  const emailResult = $('Send Customer Email').first().json;\n  if (emailResult && (emailResult.id || emailResult.threadId)) {\n    emailStatus = 'sent';\n  } else if (emailResult && emailResult.error) {\n    emailStatus = 'failed';\n    emailError = emailResult.error.message || JSON.stringify(emailResult.error);\n  } else {\n    emailStatus = 'sent';\n  }\n} catch (e) {\n  emailStatus = 'failed';\n  emailError = e.message;\n}\n\n// \u2500\u2500 Check Discord result \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet notificationStatus = 'pending';\nlet discordError = '';\ntry {\n  const discordResult = $('Send Discord Notification').first().json;\n  // Discord returns empty body on success (204), or an error object\n  if (discordResult && discordResult.code) {\n    notificationStatus = 'failed';\n    discordError = discordResult.message || 'Discord error code: ' + discordResult.code;\n  } else {\n    notificationStatus = 'sent';\n  }\n} catch (e) {\n  notificationStatus = 'failed';\n  discordError = e.message;\n}\n\n// \u2500\u2500 Check CRM result \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet crmStatus = 'pending';\nlet crmError = '';\ntry {\n  const crmResult = $('CRM Create Contact').first().json;\n  if (crmResult && crmResult.id) {\n    crmStatus = 'synced';\n  } else if (crmResult && crmResult.status === 'error') {\n    crmStatus = 'failed';\n    crmError = crmResult.message || JSON.stringify(crmResult);\n  } else if (crmResult && crmResult.category === 'CONFLICT') {\n    crmStatus = 'duplicate_in_crm';\n    crmError = 'Contact already exists in HubSpot';\n  } else {\n    // Could be mock or unexpected response\n    crmStatus = 'failed';\n    crmError = 'Unexpected CRM response: ' + JSON.stringify(crmResult).substring(0, 200);\n  }\n} catch (e) {\n  crmStatus = 'failed';\n  crmError = e.message;\n}\n\n// \u2500\u2500 Build error message \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst allErrors = [\n  lead.store_error,\n  emailError ? 'Email: ' + emailError : '',\n  discordError ? 'Discord: ' + discordError : '',\n  crmError ? 'CRM: ' + crmError : ''\n].filter(e => e).join(' | ');\n\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    timestamp: lead.timestamp,\n    name: lead.name,\n    email: lead.email,\n    phone: lead.phone,\n    company: lead.company,\n    service: lead.service,\n    budget: lead.budget,\n    message: lead.message,\n    status: lead.status,\n    is_duplicate: lead.is_duplicate,\n    email_status: emailStatus,\n    notification_status: notificationStatus,\n    crm_status: crmStatus,\n    error_message: allErrors,\n    store_error: lead.store_error\n  }\n};"
      },
