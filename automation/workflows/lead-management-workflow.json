    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Prepare parallel downstream tasks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Pass through the lead data for email, Discord, and CRM nodes\nconst lead = $('Process Duplicate Check').first().json;\n\nlet storeError = '';\ntry {\n  const storeResult = $('Store Lead in Sheets').first().json;\n  if (storeResult.error) {\n    storeError = 'Google Sheets: ' + (storeResult.error.message || JSON.stringify(storeResult.error));\n  }\n} catch (e) {\n  storeError = 'Google Sheets: ' + e.message;\n}\n\nreturn {\n  json: {\n    ...lead,\n    store_error: storeError\n  }\n};"
      },
