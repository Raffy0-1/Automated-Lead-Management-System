        "message": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9fafb; padding: 0;\">\n  <div style=\"background: linear-gradient(135deg, #6366f1, #a855f7); padding: 32px 24px; text-align: center;\">\n    <h1 style=\"color: #fff; margin: 0; font-size: 24px;\">\u26a1 DigiHust</h1>\n    <p style=\"color: rgba(255,255,255,0.85); margin: 8px 0 0; font-size: 14px;\">AI &amp; Automation Solutions</p>\n  </div>\n  <div style=\"padding: 32px 24px; background: #fff;\">\n    <h2 style=\"color: #111827; margin: 0 0 16px;\">Thank you, {{ $json.name }}!</h2>\n    <p style=\"color: #4b5563; line-height: 1.6; margin: 0 0 16px;\">We've received your inquiry and our team is reviewing your project details. You can expect to hear from us within <strong>24 hours</strong>.</p>\n    <div style=\"background: #f3f4f6; border-radius: 8px; padding: 20px; margin: 24px 0;\">\n      <h3 style=\"color: #374151; margin: 0 0 12px; font-size: 15px;\">\ud83d\udccb Your Submission Summary</h3>\n      <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n        <tr><td style=\"padding: 6px 8px; color: #6b7280; width: 110px;\">Reference</td><td style=\"padding: 6px 8px; color: #111827; font-family: monospace;\">{{ $json.lead_id }}</td></tr>\n        <tr><td style=\"padding: 6px 8px; color: #6b7280;\">Service</td><td style=\"padding: 6px 8px; color: #111827;\">{{ $json.service }}</td></tr>\n        <tr><td style=\"padding: 6px 8px; color: #6b7280;\">Budget</td><td style=\"padding: 6px 8px; color: #111827;\">{{ $json.budget }}</td></tr>\n        <tr><td style=\"padding: 6px 8px; color: #6b7280;\">Company</td><td style=\"padding: 6px 8px; color: #111827;\">{{ $json.company }}</td></tr>\n      </table>\n    </div>\n    <p style=\"color: #4b5563; line-height: 1.6; margin: 0;\">If you have any urgent questions, reply directly to this email.</p>\n  </div>\n  <div style=\"padding: 20px 24px; text-align: center; background: #f9fafb; border-top: 1px solid #e5e7eb;\">\n    <p style=\"color: #9ca3af; font-size: 12px; margin: 0;\">&copy; 2026 DigiHust AI &amp; Automation. All rights reserved.</p>\n  </div>\n</div>",
