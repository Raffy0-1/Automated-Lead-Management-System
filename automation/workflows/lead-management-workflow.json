    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Check Duplicate Results \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst items = $input.all();\nconst leadData = $('Generate Lead ID').first().json;\n\n// If Google Sheets returned rows, we have a duplicate\n// The search node returns matching rows; if none found, it returns\n// an empty result or a single item with no data\nlet isDuplicate = false;\nlet existingLeadId = '';\n\nif (items.length > 0) {\n  const firstResult = items[0].json;\n  // Check if the result actually has data (not an empty response)\n  if (firstResult && firstResult.email && firstResult.email === leadData.email) {\n    isDuplicate = true;\n    existingLeadId = firstResult.lead_id || 'unknown';\n  }\n}\n\nreturn {\n  json: {\n    ...leadData,\n    is_duplicate: isDuplicate,\n    existing_lead_id: existingLeadId,\n    status: isDuplicate ? 'duplicate' : 'new'\n  }\n};"
      },
