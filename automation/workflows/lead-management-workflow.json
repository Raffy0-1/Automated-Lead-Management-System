    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Generate Lead ID & Timestamp \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst input = $input.first().json;\nconst now = new Date();\n\n// Format: LEAD-YYYYMMDD-XXXX (random 4-digit hex)\nconst datePart = now.toISOString().slice(0, 10).replace(/-/g, '');\nconst randomPart = Math.random().toString(16).substring(2, 6).toUpperCase();\nconst leadId = `LEAD-${datePart}-${randomPart}`;\n\nconst timestamp = now.toISOString();\n\nreturn {\n  json: {\n    lead_id: leadId,\n    timestamp: timestamp,\n    ...input.data,\n    status: 'new',\n    email_status: 'pending',\n    notification_status: 'pending',\n    crm_status: 'pending',\n    error_message: ''\n  }\n};"
      },
