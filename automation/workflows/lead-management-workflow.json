    {
      "parameters": {
        "jsCode": "// \u2500\u2500 Validate & Sanitize Input \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst input = $input.first().json.body;\n\n// Helper: trim and collapse whitespace\nfunction clean(val) {\n  return (val || '').toString().trim().replace(/\\s+/g, ' ');\n}\n\n// Helper: basic HTML entity escaping\nfunction sanitize(val) {\n  return clean(val)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#x27;');\n}\n\n// Extract and sanitize fields\nconst name    = sanitize(input.name);\nconst email   = clean(input.email).toLowerCase();\nconst phone   = sanitize(input.phone);\nconst company = sanitize(input.company);\nconst service = sanitize(input.service);\nconst budget  = sanitize(input.budget);\nconst message = sanitize(input.message);\n\n// Validation errors\nconst errors = [];\n\nif (!name || name.length < 2) {\n  errors.push('Name is required (min 2 characters)');\n}\nif (name.length > 100) {\n  errors.push('Name must be under 100 characters');\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!email || !emailRegex.test(email)) {\n  errors.push('A valid email address is required');\n}\n\nconst phoneRegex = /^[+]?[\\d\\s\\-().]{7,20}$/;\nif (!phone || !phoneRegex.test(phone)) {\n  errors.push('A valid phone number is required');\n}\n\nif (!company) {\n  errors.push('Company is required');\n}\n\nif (!service) {\n  errors.push('Service is required');\n}\n\nif (!budget) {\n  errors.push('Budget is required');\n}\n\nif (!message) {\n  errors.push('Message is required');\n}\nif (message.length > 2000) {\n  errors.push('Message must be under 2000 characters');\n}\n\n// Output\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors: errors,\n    data: {\n      name,\n      email,\n      phone,\n      company,\n      service,\n      budget,\n      message\n    }\n  }\n};"
      },
